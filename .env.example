# ==============================================================================
# PocketSentinel — Environment Configuration
# Target: Total Recall | Tatum x Walrus Memory Hackathon
# ==============================================================================

# 1. Walrus Memory (Official @mysten-incubation/memwal Integration)
# Generate your Account ID & Delegate Key at: https://memory.walrus.xyz/dashboard
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_DELEGATE_PUBLIC_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=pocketsentinel

# 2. Tatum Sui Mainnet Gateway & RPC
# Get your free API key at: https://dashboard.tatum.io/
TATUM_API_KEY=
TATUM_SUI_RPC=https://sui-mainnet.gateway.tatum.io

# 3. Groq Cloud AI Copilot (Sub-300ms Qwen & LLaMA Financial Reasoning)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 4. Google Gemma & Gemini Multimodal Vision (Local Ollama, vLLM, or Google AI Studio)
GEMMA_ENDPOINT=http://localhost:11434/api/generate
GEMMA_MODEL=gemma2:9b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 5. Server Configuration
PORT=3000

# 6. Split Deployment (Vercel frontend → Render backend)
# Set ALLOWED_ORIGIN on Render to your Vercel domain(s), comma-separated:
ALLOWED_ORIGIN=https://pocketsentinel.vercel.app
# Protects admin routes (seed, purge). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
